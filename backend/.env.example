# Rafeeq backend settings for local development.
#   cp backend/.env.example backend/.env    (backend/.env is git-ignored)
# Run backend commands from backend/: the file is read from the current directory.
# Every name maps to a field of backend/app/core/config.py (case-insensitive).
# Nothing here is a real secret. Never commit backend/.env.
# Full table with what each one does: README.md, "Environment variables".
# Lines starting with "# " show the default; uncomment to change it.

# --- Core -------------------------------------------------------------------
ENV=development
PUBLIC_URL=http://localhost:5173
# Postgres 16 with pgvector; matches the docker command in README.md.
DATABASE_URL=postgresql+asyncpg://rafeeq:rafeeq_dev@127.0.0.1:5442/rafeeq
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-value
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=60

# --- First admin (created at startup only if no admin exists) ---------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-local-admin-password

# --- Content and corpus paths (absolute paths, no ~) ------------------------
# CONTENT_DIR=/path/to/rafeeq/content
# HISNMUSLIM_DIR=/path/to/rafeeq/data/hisnmuslim
# CORPUS_DIR=/home/you/.local/share/rafeeq/corpus
# RAFEEQ_DATA_DIR is read from the shell only (export it), not from this file.

# --- AI (OpenRouter). Empty key = the app runs; the assistant, explanations and embeddings are off.
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_BUDGET_USD=10.0
# AI_DAILY_BUDGET_USD=0.75
# AI_EMBED_DAILY_BUDGET_USD=1.00
# AI_MODEL_MAIN=google/gemma-4-31b-it
# AI_MODEL_FAST=google/gemma-4-26b-a4b-it
# AI_MODEL_FALLBACK=deepseek/deepseek-v4-pro
# AI_EMBEDDING_MODEL=baai/bge-m3

# --- Answer retrieval and reliability ---------------------------------------
# KNW_ANSWER_SOURCES=quranenc,hadeethenc,islamhouse_enc,binbaz,islamqa,rafeeq_cards
# KNW_SEARCH_K=8
# KNW_MIN_SIMILARITY=0.0
# KNW_QUOTE_MAX_WORDS=6
# KNW_SCRIPTURE_OVERLAP_WORDS=6
# KNW_PREFERRED_SOURCE=
# KNW_NEAR_TIE_EPSILON=0.0006
# KNW_EMBED_JOB_LIMIT=4000        # 0 turns the background embedding job off
# KNW_EMBED_JOB_MINUTES=10
# ASK_DEADLINE_SECONDS=45.0
# ASK_MAX_EXTERNAL_CALLS=8
# ASK_MAX_RETRIEVAL_ROUNDS=2
# ASK_MAX_COMPOSE_ROUNDS=2
# ASK_QUERY_NORMALIZATION_ENABLED=true
# ASK_REPAIR_ENABLED=true
# ASK_APPROVED_FAQ_ENABLED=true

# --- Live sources (on by default; local-index-v2 answers from the local index only)
# ASK_SOURCE_POLICY=live-enabled-sources-any-sufficient-v3
# ASK_LIVE_SOURCES=islamqa,binbaz
# ASK_LIVE_ISLAMIC_CONTENT_SEARCH_PERMITTED=false
# ASK_LIVE_DEADLINE_SECONDS=60.0
# ASK_LIVE_WINDOW_SECONDS=20.0
# ASK_LIVE_MAX_CALLS_PER_SOURCE=4
# ASK_LIVE_MAX_CALLS=16
# ASK_LIVE_MAX_AI_CALLS=6
# ASK_LIVE_RECORDS_PER_SOURCE=2
# ASK_LIVE_CHUNKS_PER_RECORD=2
# ASK_LIVE_REQUEST_TIMEOUT_SECONDS=8.0
# ASK_LIVE_USER_AGENT=RafeeqBot/1.0 (+https://rafeeq.nan.sa)

# --- Library search and home (feature flags) --------------------------------
# LIBRARY_SEARCH_ENABLED=true
# LIBRARY_SEARCH_SOURCES=islamic_content,islamhouse
# LIBRARY_SEARCH_WINDOW_SECONDS=12.0
# LIBRARY_SEARCH_REQUEST_TIMEOUT_SECONDS=8.0
# LIBRARY_SEARCH_MAX_CALLS_PER_SOURCE=4
# LIBRARY_SEARCH_MAX_CALLS=8
# LIBRARY_SEARCH_SESSION_SECONDS=300
# LIBRARY_SEARCH_MAX_SESSIONS=2000
# PLT09_ORGANIZED_HOME=true

# --- Web Push (optional). Generate a pair: README.md, "Optional: push notifications"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Email for optional two-step sign-in (empty host = off) -----------------
SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Rafeeq <no-reply@example.com>
