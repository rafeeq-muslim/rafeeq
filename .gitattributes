# Text files are stored with LF and checked out with LF on every OS, so shell
# scripts, Dockerfiles and compose files work in Linux containers even when the
# repo is cloned on Windows.
* text=auto eol=lf

*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.conf text eol=lf
*.inc text eol=lf

# Binary files: never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.ogg binary
*.opus binary
*.pdf binary
*.sqlite binary
*.zip binary
*.gz binary

# Fetched source dumps are kept byte for byte as downloaded (rules.md 1.3:
# source texts are never modified), whatever their line endings.
data/** -text
