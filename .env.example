# Settings for `docker compose -f docker-compose.local.yml up`.
# Copy to `.env` (never commit `.env`). Every value has a working default for a
# local run, so this file is optional. Placeholders only: put real keys in `.env`.

# Ports on your machine (127.0.0.1 only). Change them if something else uses them.
# Landing at http://localhost:8380/ , the app at http://localhost:8380/app/
WEB_PORT=8380
# The API directly (docs at /api/docs); the web port proxies /api too
API_PORT=8390
# PostgreSQL, for psql or a DB client
DB_PORT=5444

# Local secrets: change them. Generate a value with
#   docker run --rm python:3.12-slim python -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=change-me-local-db-password
JWT_SECRET=change-me-generate-a-long-random-value

# The first admin, created at startup only if no admin exists yet.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-local-admin-password

# 1 = fetch (first run only) and load the QuranEnc text so lessons show verses. 0 = skip.
LOAD_QURANENC=1

# Optional. Any setting from backend/.env.example can be added here and reaches the backend.
# The AI assistant (https://openrouter.ai/keys):
# OPENROUTER_API_KEY=
# Push notifications (the public key is also baked into the web build):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
